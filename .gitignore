# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# --- Local configuration and secrets ---
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key

# --- Private resumes / user data (never commit) ---
data/private/
data/raw/*
!data/raw/.gitkeep
uploads/
storage/uploads/
artifacts/uploads/

# --- Generated artifacts (rebuildable) ---
data/processed/*
!data/processed/.gitkeep
artifacts/*
!artifacts/.gitkeep
!artifacts/models/.gitkeep
*.faiss
*.npy
*.joblib
*.sqlite
*.sqlite3
*.db

# --- Generated sample binaries are committed deliberately (small, synthetic) ---
!data/sample/resumes/*.pdf
!data/sample/resumes/*.docx

# --- Logs / monitoring dumps ---
*.log
logs/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Freebuff workspace metadata ---
.freebuff/
