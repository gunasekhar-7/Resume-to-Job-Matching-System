# Copy to .streamlit/secrets.toml (ignored by Git) and fill in your provider values.
# Streamlit's OIDC login is the UI gate. The ID token is forwarded server-side to the
# API; it is never placed in browser-visible application data.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-long-random-value"
client_id = "your-oidc-client-id"
client_secret = "your-oidc-client-secret"
server_metadata_url = "https://your-issuer.example/.well-known/openid-configuration"
# Required for the API to receive a verified per-user identity.
expose_tokens = "id"
