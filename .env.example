# TalentLens environment configuration (copy to .env; never commit .env)

# --- Core ---
TALENTLENS_ENV=development
TALENTLENS_CONFIG=configs/default.yaml
TALENTLENS_LOG_LEVEL=INFO

# --- Storage ---
# SQLite is the default for local development. PostgreSQL is used by docker-compose.
TALENTLENS_DATABASE_URL=sqlite:///./artifacts/talentlens.db
# TALENTLENS_DATABASE_URL=postgresql+psycopg2://talentlens:talentlens@localhost:5432/talentlens

# --- API ---
TALENTLENS_API_HOST=0.0.0.0
TALENTLENS_API_PORT=8000
TALENTLENS_API_BASE_URL=http://localhost:8000
TALENTLENS_CORS_ORIGINS=http://localhost:8501
TALENTLENS_RATE_LIMIT_PER_MINUTE=60

# --- Models ---
# Use "sentence_transformers" when the model is available locally or downloadable.
TALENTLENS_EMBEDDING_BACKEND=sentence_transformers
TALENTLENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TALENTLENS_RERANKER_ENABLED=false

# --- Privacy / retention ---
# Hours after which uploaded resume content is purged (deletion is also user-triggered).
TALENTLENS_RESUME_RETENTION_HOURS=24

# --- Frontend ---
TALENTLENS_FRONTEND_API_URL=http://localhost:8000
