# TalentLens environment configuration (copy to .env; never commit .env)

# --- Core ---
TALENTLENS_ENV=development
TALENTLENS_CONFIG=configs/default.yaml
TALENTLENS_LOG_LEVEL=INFO

# --- Storage ---
# SQLite is the default for local development. PostgreSQL is used by docker-compose.
TALENTLENS_DATABASE_URL=sqlite:///./artifacts/talentlens.db
# Docker Compose reads this separately; generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=
# TALENTLENS_DATABASE_URL=postgresql+psycopg2://talentlens:CHANGE_ME@localhost:5432/talentlens

# --- API ---
TALENTLENS_API_HOST=127.0.0.1
TALENTLENS_API_PORT=8000
TALENTLENS_API_BASE_URL=http://localhost:8000
TALENTLENS_CORS_ORIGINS=http://localhost:8501
TALENTLENS_RATE_LIMIT_PER_MINUTE=60
# Required for production/docker. Leave empty only for a loopback-only local demo.
TALENTLENS_API_TOKEN=
TALENTLENS_REQUIRE_AUTH=false
# Per-user OIDC identity. Set all three plus REQUIRE_IDENTITY=true for multi-user deployments.
# The API verifies the ID token forwarded by the trusted Streamlit server.
TALENTLENS_OIDC_ISSUER=
TALENTLENS_OIDC_AUDIENCE=
TALENTLENS_OIDC_JWKS_URL=
TALENTLENS_REQUIRE_IDENTITY=false
# Set true only when the cookie travels over HTTPS (directly or via a trusted proxy).
TALENTLENS_COOKIE_SECURE=false

# --- Models ---
# Use "sentence_transformers" when the model is available locally or downloadable.
TALENTLENS_EMBEDDING_BACKEND=sentence_transformers
TALENTLENS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TALENTLENS_RERANKER_ENABLED=false

# --- Privacy / retention ---
# Hours after which uploaded resume content is purged (deletion is also user-triggered).
TALENTLENS_RESUME_RETENTION_HOURS=24
# Background expiry sweep interval; 0 disables it (startup still purges).
TALENTLENS_RETENTION_PURGE_INTERVAL_SECONDS=3600

# --- Frontend ---
# Streamlit reads this name; Compose overrides it with the service hostname.
TALENTLENS_API_URL=http://localhost:8000
# Optional Streamlit OIDC login; configure .streamlit/secrets.toml [auth] first.
TALENTLENS_UI_AUTH=false
